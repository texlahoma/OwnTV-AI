<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: every variant points its icon and branding image at the transparent drawable —
         the launch splash shows nothing but the window background before the first frame lands on
         Home. The splash-holding condition is gone too (MainActivity); the seam manifest holds both. -->
    <style name="Theme.OwnTV.Starting.Petrol">
        <item name="windowSplashScreenAnimatedIcon">@drawable/owntv_splash_transparent</item>
        <item name="windowSplashScreenAnimationDuration">800</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/owntv_splash_transparent</item>
    </style>
    <style name="Theme.OwnTV.Starting.Sunflower">
        <item name="windowSplashScreenAnimatedIcon">@drawable/owntv_splash_transparent</item>
        <item name="windowSplashScreenAnimationDuration">800</item>
